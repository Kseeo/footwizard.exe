[Unit]
Description=Foot Extract Wizard web app
After=footwizard-xvfb.service
Requires=footwizard-xvfb.service

[Service]
# <REPO_ROOT>, <PYTHON_BIN>: deploy/README.md 참고. <PYTHON_BIN>은 flask,
# trimesh, opencv-python(-headless), mediapipe, scipy, scikit-learn,
# networkx, "pyglet<2", fast_simplification, waitress가 전부 설치된
# 파이썬이어야 한다(더는 requests 불필요 -- GNN 예측이 HTTP가 아니라
# gnn_predict.py를 통해 이 프로세스 안에서 직접 돈다).
#
# GNN_REPO_DIR/GNN_PYTHON/GNN_TRAIN_DATASET_PATH/GNN_TRAIN_DATASET_FILE
# 기본값이 이 배포 기준 경로(gnn_predict.py 참고)와 다르면 아래처럼
# Environment= 줄을 추가해서 덮어쓴다.
WorkingDirectory=<REPO_ROOT>/webapp
Environment=DISPLAY=:99
Environment=HOST=0.0.0.0
Environment=PORT=5051
ExecStart=<PYTHON_BIN> <REPO_ROOT>/webapp/serve.py
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
